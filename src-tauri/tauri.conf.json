{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scorpio",
  "version": "0.1.0",
  "identifier": "com.lxxvii.scorpio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "CS2 crosshair overlay",
    "license": "PolyForm-Noncommercial-1.0.0",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true,
    "publisher": "LXXVII",
    "copyright": "© 2026 LXXVII. PolyForm Noncommercial 1.0.0.",
    "homepage": "https://github.com/Deikus-LXXVII/Scorpio-Crosshair",
    "longDescription": "A light CS2-style crosshair overlay that shows only while your game is in front, and never touches the game or its anti-cheat.",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/scorpio.desktop"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBODJCRjQ0NEVGMTg3NTMKUldSVGgvRk9STCtDQ3ZLdFBnbXdoME12ZDVLVDJIb29xbDlPWmhaVk1rY2xmZTB0aTBKVkFub0MK",
      "endpoints": [
        "https://github.com/Deikus-LXXVII/Scorpio-Crosshair/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
