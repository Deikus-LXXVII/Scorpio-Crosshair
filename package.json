{
  "name": "scorpio",
  "productName": "Scorpio",
  "version": "0.1.0",
  "description": "A CS2-style crosshair overlay for Windows and Linux that shows only while your game is in focus",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "main": "src/main/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run css && electron .",
    "css": "sass src/renderer/styles/settings.scss:src/renderer/styles/dist/settings.css src/renderer/styles/overlay.scss:src/renderer/styles/dist/overlay.css --no-source-map -s compressed",
    "test": "node --test test/unit/",
    "lint": "eslint src test",
    "check": "npm run lint && npm test",
    "build:win": "npm run css && electron-builder --win nsis --x64 --publish never",
    "build:linux": "npm run css && electron-builder --linux AppImage deb --x64 --publish never"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "sass": "^1.93.0"
  },
  "build": {
    "appId": "com.lxxvii.scorpio",
    "productName": "Scorpio",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "!src/renderer/styles/*.scss",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "lxxvii"
    }
  }
}
